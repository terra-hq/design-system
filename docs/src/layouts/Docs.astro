---
import { getCollection } from 'astro:content'
import '@fontsource/uncut-sans/400.css'
import '@fontsource/uncut-sans/500.css'
import '@fontsource/ibm-plex-mono/400.css'

const { title, description, group, status, id } = Astro.props
const docs = await getCollection('docs')
const groups = [['start', 'start'], ['foundation', 'foundation f--'], ['utilities', 'utilities u--'], ['project', 'project']] as const
const nav = groups.map(([g, label]) => ({
  label,
  items: docs.filter(d => d.data.group === g).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
}))
const href = (id: string) => (id === 'index' ? '/' : `/${id}/`)
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · terra design system</title>
  {description && <meta name="description" content={description} />}
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t } catch (e) {}
  </script>
</head>
<body>
<div class="shell">
  <aside class="side">
    <a class="brand" href="/"><i></i>terra design system</a>
    {nav.map(g => (
      <nav>
        <h4>{g.label}</h4>
        {g.items.map(d => (
          <a class:list={['nav', { on: d.id === id }]} href={href(d.id)}>
            {d.data.title}{(d.data.status === 'new' || d.data.status === 'proposed') && <span class="tag" data-s={d.data.status}>{d.data.status}</span>}
          </a>
        ))}
      </nav>
    ))}
    <button id="theme" type="button" aria-label="toggle theme">theme</button>
  </aside>
  <main>
    <p class="caption">{group}</p>
    <h1>{title}</h1>
    {description && <p class="lead">{description}</p>}
    <article><slot /></article>
  </main>
</div>
<script>
  document.getElementById('theme')?.addEventListener('click', () => {
    const el = document.documentElement
    const dark = el.dataset.theme ? el.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
    el.dataset.theme = dark ? 'light' : 'dark'
    try { localStorage.setItem('theme', el.dataset.theme) } catch {}
  })
</script>
</body>
</html>

<style is:global>
  /* DESIGN.md roles. Light: Morning Haze page, white raised. Dark: Noche, told apart by 1px white-alpha edges. */
  :root{
    --page:#f7f8f4;--raised:#ffffff;--sunk:rgb(15 15 15/.06);--edge:rgb(15 15 15/.14);--strong:rgb(15 15 15/.45);
    --ink:#0f0f0f;--soft:rgb(15 15 15/.85);--mute:rgb(15 15 15/.68);--faint:rgb(15 15 15/.45);--on-ink:#ffffff;--neon:#7ce55e;
    --sans:'Uncut Sans','Uncut Sans Fallback',system-ui,sans-serif;--mono:'IBM Plex Mono',ui-monospace,monospace;color-scheme:light;
  }
  @media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
    --page:#0f0f0f;--raised:#0f0f0f;--sunk:rgb(255 255 255/.08);--edge:rgb(255 255 255/.18);--strong:rgb(255 255 255/.5);
    --ink:#ffffff;--soft:rgb(255 255 255/.88);--mute:rgb(255 255 255/.7);--faint:rgb(255 255 255/.45);--on-ink:#0f0f0f;color-scheme:dark}}
  :root[data-theme="dark"]{--page:#0f0f0f;--raised:#0f0f0f;--sunk:rgb(255 255 255/.08);--edge:rgb(255 255 255/.18);--strong:rgb(255 255 255/.5);
    --ink:#ffffff;--soft:rgb(255 255 255/.88);--mute:rgb(255 255 255/.7);--faint:rgb(255 255 255/.45);--on-ink:#0f0f0f;color-scheme:dark}

  *{box-sizing:border-box}
  body{margin:0;background:var(--page);color:var(--ink);font:400 14px/20px var(--sans)}
  :focus-visible{outline:2px solid var(--ink);outline-offset:2px}
  a{color:inherit}
  code{font-family:var(--mono);font-size:12.5px;background:var(--sunk);border-radius:8px;padding:2px 6px}
  pre{background:var(--sunk);border-radius:12px;padding:16px;overflow:auto;font-size:12.5px;line-height:1.7}
  pre code{background:none;padding:0}

  .shell{display:grid;grid-template-columns:260px minmax(0,1fr);min-height:100vh;
    padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
  .side{position:sticky;top:0;align-self:start;height:100vh;overflow:auto;padding:24px 20px 24px 0;border-right:1px solid var(--edge);display:flex;flex-direction:column;gap:4px}
  .brand{display:flex;align-items:center;gap:10px;font-weight:500;font-size:16px;line-height:20px;letter-spacing:-.01em;text-decoration:none;margin-bottom:12px}
  .brand i{width:28px;height:28px;border-radius:50%;background:var(--ink)}
  .side h4{margin:18px 0 4px;font-size:12px;font-weight:500;color:var(--mute)}
  .nav{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;color:var(--mute);text-decoration:none}
  .nav:hover{background:var(--sunk);color:var(--ink)}
  .nav.on{background:var(--ink);color:var(--on-ink);font-weight:500}
  .nav.on::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--neon);margin-right:8px}
  .nav{justify-content:flex-start}.nav .tag{margin-left:auto}
  .tag[data-s=proposed]{border-color:#ffb41d}
  .tag{border:1px solid var(--neon);color:inherit;border-radius:999px;font-size:12px;font-weight:500;padding:0 8px;line-height:20px}
  #theme{margin-top:auto;align-self:flex-start;border:1px solid var(--strong);background:var(--raised);color:var(--ink);border-radius:999px;height:28px;padding:0 12px;font:500 12px var(--sans);cursor:pointer}
  #theme:hover{background:var(--sunk)}

  main{min-width:0;padding:48px 0 96px 56px;max-width:960px}
  .caption{margin:0 0 8px;font-size:12px;font-weight:500;color:var(--mute)}
  h1{margin:0 0 12px;font-size:clamp(40px,6vw,80px);line-height:1.1;font-weight:500;letter-spacing:-.03em;text-transform:lowercase}
  h2{margin:56px 0 12px;font-size:32px;line-height:1.3;font-weight:500;letter-spacing:-.02em;text-transform:lowercase}
  h3{margin:28px 0 8px;font-size:18px;line-height:28px;font-weight:500;letter-spacing:-.01em}
  .lead{margin:0 0 32px;font-size:24px;line-height:1.4;color:var(--mute);max-width:60ch}
  article p,article li{max-width:68ch;font-size:15px;line-height:22px}
  article table{display:table;width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--edge);border-radius:16px;overflow:hidden;background:var(--raised);margin:16px 0}
  article th{background:var(--sunk);color:var(--soft);font-weight:500;font-size:12px;text-align:left}
  article th,article td{padding:12px 16px;border-bottom:1px solid var(--edge);vertical-align:top;font-size:13.5px}
  article tr:last-child td{border-bottom:0}
  blockquote{margin:16px 0;padding:12px 16px;background:var(--raised);border:1px solid var(--edge);border-radius:12px;color:var(--soft)}
  blockquote p{margin:0}
  hr{border:0;border-top:1px solid var(--edge);margin:40px 0}

  @media (max-width:860px){
    .shell{display:block}
    .side{position:static;height:auto;border:0;padding:16px 0;flex-direction:row;flex-wrap:wrap;align-items:center}
    .side h4{display:none}.side nav{display:contents}.brand{margin:0 12px 0 0}#theme{margin:0 0 0 auto}
    main{padding:24px 0 64px}
  }
</style>
