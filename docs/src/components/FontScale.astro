---
// Renders every f--font-* class inside an iframe whose WIDTH you control, so the real media query fires.
// The px next to each sample is read from the browser (getComputedStyle), not typed by hand.
const rows = ['a', 'b', 'c', 'd', 'e', 'f']
const sample = rows.map(k => `<div class="row"><div class="meta"><code>f--font-${k}</code><span class="px"></span></div><div class="f--font-${k}" data-k>Terra studio</div></div>`).join('')
const page = `<!doctype html><link rel="stylesheet" href="/fonts.css"><link rel="stylesheet" href="/terra.css">
<style>body{margin:0;padding:20px;background:#f7f8f4;color:#0f0f0f}.row{padding:14px 0;border-bottom:1px solid rgba(15,15,15,.14)}.meta{display:flex;gap:10px;margin-bottom:6px;font:11px ui-monospace,Menlo,monospace;color:rgba(15,15,15,.68)}.px{color:#0f0f0f}</style>
${sample}
<script>function u(){document.querySelectorAll('[data-k]').forEach(function(e){e.parentNode.querySelector('.px').textContent=getComputedStyle(e).fontSize+' / '+getComputedStyle(e).lineHeight.replace('px','px')+' line'})}addEventListener('resize',u);u();<\/script>`
---
<div class="fs">
  <div class="bar">
    <label for="fs-w">screen width <output id="fs-out">1200px</output></label>
    <input id="fs-w" type="range" min="320" max="1400" step="10" value="1200" />
    <div class="presets" role="group" aria-label="screen presets">
      <button type="button" data-w="390">mobile 390</button>
      <button type="button" data-w="580">580</button>
      <button type="button" data-w="810">tablets 810</button>
      <button type="button" data-w="811">811</button>
      <button type="button" data-w="1300">desktop 1300</button>
    </div>
    <p class="state" id="fs-state"></p>
  </div>
  <div class="scroll"><iframe id="fs-frame" title="typography at the chosen screen width" srcdoc={page} style="width:1200px"></iframe></div>
</div>
<style>
  .fs{border:1px solid var(--edge);border-radius:16px;background:var(--raised);overflow:hidden;margin:24px 0}
  .bar{padding:16px 20px;border-bottom:1px solid var(--edge);display:grid;gap:10px}
  label{font-weight:500;display:flex;gap:10px;align-items:baseline}
  output{font-family:var(--mono);font-size:12.5px;color:var(--mute)}
  input[type=range]{width:100%;accent-color:var(--ink)}
  .presets{display:flex;flex-wrap:wrap;gap:6px}
  .presets button{border:1px solid var(--strong);background:var(--raised);color:var(--ink);border-radius:999px;height:28px;padding:0 12px;font:500 12px var(--sans);cursor:pointer}
  .presets button:hover{background:var(--sunk)}
  .state{margin:0;font-size:13px;color:var(--mute)}
  .scroll{overflow-x:auto;background:var(--sunk)}
  iframe{display:block;border:0;height:620px;max-width:none}
</style>
<script>
  const w = document.getElementById('fs-w') as HTMLInputElement
  const out = document.getElementById('fs-out')!, frame = document.getElementById('fs-frame') as HTMLIFrameElement, state = document.getElementById('fs-state')!
  const set = (v: number) => {
    w.value = String(v); out.textContent = `${v}px`; frame.style.width = `${v}px`
    state.textContent = v <= 810
      ? 'At 810px and below, f--font-a to d switch to their smaller size. f--font-e and f--font-f don’t change.'
      : 'Above 810px, every class uses its desktop size.'
  }
  w.addEventListener('input', () => set(+w.value))
  document.querySelectorAll<HTMLButtonElement>('.presets button').forEach(b => b.addEventListener('click', () => set(+b.dataset.w!)))
  set(+w.value)
</script>
