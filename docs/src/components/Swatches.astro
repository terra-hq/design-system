---
// Palette as it ships in src/scss/framework/_var/_vars.scss
const colors = [['a','#0f0f0f','ink'],['b','#fefefe','paper'],['c','#f7f8f4','fog'],['d','#7ce55e','lime'],['e','#2d9f66','forest'],['f','#429ed6','sky'],['g','#fdb335','amber'],['h','#f76e4a','coral'],['i','#f58dd7','pink']]
---
<div class="sw">{colors.map(([k, hex, name]) => (
  <div class="c"><b style={`background:${hex}`}></b><span><code>f--color-{k}</code>{hex} · {name}</span></div>
))}</div>
<style>
  .sw{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin:20px 0}
  .c{border:1px solid var(--edge);border-radius:16px;overflow:hidden;background:var(--raised);font-size:12px}
  .c b{display:block;height:64px;border-bottom:1px solid var(--edge)}
  .c span{display:grid;gap:2px;padding:10px 12px;color:var(--mute)}
  .c code{color:var(--ink);background:none;padding:0}
</style>
