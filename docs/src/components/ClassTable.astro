---
// Every class that matches `match` in the compiled CSS. Add a class in the SCSS, rebuild, it shows up here.
import classes from '../data/classes.json'
const { match, title } = Astro.props
const re = new RegExp(match)
const list = (classes as string[]).filter(c => re.test(c))
---
<details class="ct">
  <summary>{title ?? match} <span class="ct-n">{list.length} classes</span></summary>
  <ul>{list.map(c => <li><code>{c}</code></li>)}</ul>
</details>
<style>
  .ct{border:1px solid var(--edge);border-radius:16px;background:var(--raised);margin:16px 0;padding:0 20px}
  summary{cursor:pointer;padding:14px 0;font-weight:500;display:flex;justify-content:space-between;gap:12px}
  .ct-n{color:var(--mute);font-weight:400;font-size:13px}
  ul{list-style:none;margin:0;padding:0 0 16px;display:flex;flex-wrap:wrap;gap:6px;max-height:260px;overflow:auto}
  li code{background:var(--sunk);border-radius:8px;padding:2px 8px;font-size:12px}
</style>
