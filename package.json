    "src/scss",
    "bin",
    "terra.config.example.js"
  ],
  "dependencies": {
    "sass": "^1.69.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terra-hq/design-system.git"
  },
  "homepage": "https://dev.terrahq.com/design-system",
  "bugs": {
    "url": "https://github.com/terra-hq/design-system/issues"
  },
  "keywords": [
    "terra",
    "design-system",
