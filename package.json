{
  "name": "@terrahq/design-system",
  "private": false,
  "version": "0.3.1",
  "type": "module",
  "exports": {
    ".": "./dist/style.css",
    "./icons.css": "./dist/icons.css",
    "./terraforms.css": "./dist/terraforms.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-masks.mjs",
